{
  "name": "@oceanum/webbeach",
  "version": "0.1.0",
  "license": "LGPL-3.0-or-later",
  "exports": "./solver.ts",
  "imports": {
    "@std/assert": "jsr:@std/assert@^1"
  },
  "tasks": {
    "run": "deno run --allow-read --allow-write --allow-env src/cli/run.ts",
    "test": "deno test --allow-read --allow-write --allow-env test/",
    "check": "deno check solver.ts src/cli/run.ts",
    "build": "bash scripts/build.sh"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2
  },
  "compilerOptions": {
    "lib": ["deno.window", "deno.unstable"],
    "strict": true
  }
}
